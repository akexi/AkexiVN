<Window x:Class="AkexiVN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkexiVN"
        mc:Ignorable="d"
        Title="AkexiVN"
        Width="1280"
        Height="720"
        MinWidth="1280"
        MinHeight="720"
        MaxWidth="1280"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <Window.Resources>
        <Style x:Key="MainMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F7F3EC"/>
            <Setter Property="FontFamily" Value="Yu Mincho"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="4,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Arrow" Text="▶" Width="24" Foreground="#E9C58D" Opacity="0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#E9C58D"/>
                                <Setter Property="Background" Value="#301A2028"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="8" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Audio Players -->
        <MediaElement x:Name="BgmPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Volume="0.5"
                      Visibility="Collapsed"/>

        <MediaElement x:Name="SePlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Volume="0.8"
                      Visibility="Collapsed"/>

        <!-- Main Menu Panel -->
        <Grid x:Name="MainMenuPanel" Visibility="Visible">
            <Image Source="/AkexiVN;component/Assets/Backgrounds/main_menu_background.jpg" Stretch="UniformToFill"/>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C9141A20" Offset="0"/>
                        <GradientStop Color="#80141A20" Offset="0.38"/>
                        <GradientStop Color="#10141A20" Offset="0.78"/>
                        <GradientStop Color="#00141A20" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="110,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="390">
                <StackPanel>
                    <StackPanel x:Name="MainMenuTitlePanel" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="12"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.55"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.55"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <TextBlock Text="AkexiVN" Foreground="#FFF9F1" FontFamily="Yu Mincho" FontSize="54" FontWeight="Bold"/>
                        <TextBlock Text="A Visual Novel" Foreground="#E9C58D" FontFamily="Yu Mincho" FontSize="16" Margin="5,3,0,42"/>
                        <Rectangle Height="1" Width="250" Fill="#A8E9C58D" HorizontalAlignment="Left" Margin="4,0,0,22"/>
                    </StackPanel>

                    <Button x:Name="StartGameButton" Content="开始游戏" Height="48" Margin="0,0,0,4" Style="{StaticResource MainMenuButtonStyle}" Click="StartGameButton_Click">
                        <Button.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.28"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="10" To="0" Duration="0:0:0.4" BeginTime="0:0:0.28"/></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers>
                    </Button>
                    <Button x:Name="ContinueGameButton" Content="继续游戏" Height="48" Margin="0,0,0,4" Style="{StaticResource MainMenuButtonStyle}" Click="ContinueGameButton_Click">
                        <Button.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.36"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="10" To="0" Duration="0:0:0.4" BeginTime="0:0:0.36"/></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers>
                    </Button>
                    <Button x:Name="ChapterMainMenuButton" Content="章节" Height="48" Margin="0,0,0,4" Style="{StaticResource MainMenuButtonStyle}" Click="ChapterMainMenuButton_Click">
                        <Button.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.40"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="10" To="0" Duration="0:0:0.4" BeginTime="0:0:0.40"/></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers>
                    </Button>
                    <Button x:Name="LoadGameMainMenuButton" Content="读取存档" Height="48" Margin="0,0,0,4" Style="{StaticResource MainMenuButtonStyle}" Click="LoadGameMainMenuButton_Click">
                        <Button.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.44"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="10" To="0" Duration="0:0:0.4" BeginTime="0:0:0.44"/></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers>
                    </Button>
                    <Button x:Name="SettingsMainMenuButton" Content="设置" Height="48" Margin="0,0,0,4" Style="{StaticResource MainMenuButtonStyle}" Click="SettingsMainMenuButton_Click">
                        <Button.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.52"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="10" To="0" Duration="0:0:0.4" BeginTime="0:0:0.52"/></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers>
                    </Button>
                    <Button x:Name="ExitGameButton" Content="退出游戏" Height="48" Style="{StaticResource MainMenuButtonStyle}" Click="ExitGameButton_Click">
                        <Button.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.60"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="10" To="0" Duration="0:0:0.4" BeginTime="0:0:0.60"/></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="Version 0.1.0" Foreground="#D0C9BF" FontFamily="Yu Mincho" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,20"/>
        </Grid>

        <!-- Game Panel -->
        <Grid x:Name="GamePanel" Visibility="Collapsed">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>

            <Canvas x:Name="CharacterLayer"
                    Width="1280"
                    Height="720"
                    IsHitTestVisible="False"/>

            <Grid x:Name="ChapterEndPanel"
                  Visibility="Collapsed"
                  Panel.ZIndex="50">
                <Border Background="#AA000000"/>
                <Border Width="620"
                    Height="360"
                        Background="#DD101010"
                        CornerRadius="12"
                        BorderBrush="#88FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="30">
                        <TextBlock x:Name="ChapterEndChapterNumberText"
                                   Text="第一章"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ChapterEndTitleText"
                                   Text="放学后的约定"
                                   Foreground="#FFD86B"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="本章结束"
                                   Foreground="White"
                                   FontSize="22"
                                   Margin="0,0,0,22"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="✓ 已完成"
                                   Foreground="#A8E9C58D"
                                   FontSize="16"
                                   Margin="0,0,0,12"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="ChapterEndContinueButton"
                                Content="进入下一章"
                                Width="220"
                                Height="52"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                Click="ChapterEndContinueButton_Click"/>
                            <Button Content="返回主菜单"
                                Width="220"
                                Height="42"
                                Margin="0,10,0,0"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                Click="ChapterEndReturnButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="ChoicePanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="600"/>

            <Border x:Name="DialogueBox"
                    Background="#DD101010"
                    Height="180"
                    VerticalAlignment="Bottom"
                    Margin="30,0,30,20"
                    CornerRadius="10">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CharacterNameText"
                               Foreground="#FFD86B"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="DialogueText"
                               Grid.Row="1"
                               Foreground="White"
                               FontSize="22"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               LineHeight="34"/>
                </Grid>
            </Border>

            <Button x:Name="NextButton"
                    Content="▶"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,55,45"
                    FontSize="20"
                    Background="#AAFFFFFF"
                    BorderThickness="0"
                    Click="NextButton_Click"/>

            <Button x:Name="MenuButton"
                    Content="菜单"
                    Width="100"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20,20,0,0"
                    Click="MenuButton_Click"/>
        </Grid>

        <!-- Overlay Container (In-Game Menu, Save/Load Panel, Settings Panel) -->
        <Grid x:Name="OverlayContainer" Visibility="Collapsed">
            <Border Background="#AA000000"/>

            <!-- In-Game Pause Menu -->
            <Border x:Name="InGameMenuPanel"
                    Background="#CC101010"
                    Width="360"
                    CornerRadius="12"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="游戏菜单"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <Button Content="保存"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="InGameSaveButton_Click"/>

                    <Button Content="读取"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="InGameLoadButton_Click"/>

                    <Button Content="设置"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="InGameSettingsButton_Click"/>

                    <Button Content="返回标题"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="ReturnTitleButton_Click"/>

                    <Button Content="关闭"
                            Height="44"
                            Click="CloseMenuButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Save / Load Panel -->
            <Border x:Name="SaveLoadPanel"
                    Background="#EE101010"
                    Width="800"
                    Height="560"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="SaveLoadTitle"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="SaveLoadStatus"
                                   Foreground="#D0D0D0"
                                   FontSize="14"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SaveSlotList"/>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="返回"
                            Height="40"
                            Width="140"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Click="BackFromSaveLoad_Click"/>
                </Grid>
            </Border>

            <!-- Settings Panel -->
            <Border x:Name="SettingsPanel"
                    Background="#EE101010"
                    Width="600"
                    Height="400"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="设置"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,0,20,0">
                        <!-- BGM Volume -->
                        <TextBlock Text="BGM 音量" Foreground="White" FontSize="18" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BgmVolumeSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    Value="0.5"
                                    VerticalAlignment="Center"
                                    ValueChanged="BgmVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="BgmVolumeText"
                                       Grid.Column="1"
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="50%"/>
                        </Grid>

                        <!-- SE Volume -->
                        <TextBlock Text="SE 音量" Foreground="White" FontSize="18" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SeVolumeSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    Value="0.8"
                                    VerticalAlignment="Center"
                                    ValueChanged="SeVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="SeVolumeText"
                                       Grid.Column="1"
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="80%"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="返回"
                            Height="40"
                            Width="140"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Click="BackFromSettings_Click"/>
                </Grid>
            </Border>

            <!-- Chapter Selection Panel -->
            <Border x:Name="ChapterSelectPanel"
                    Background="#EE101010"
                    Width="800"
                    Height="560"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="章节选择"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChapterListPanel"/>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="返回"
                            Height="40"
                            Width="140"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Click="BackFromChapterSelect_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
