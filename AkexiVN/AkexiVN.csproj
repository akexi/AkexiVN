<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\CG\**" />
    <Compile Remove="Assets\SE\**" />
    <EmbeddedResource Remove="Assets\CG\**" />
    <EmbeddedResource Remove="Assets\SE\**" />
    <None Remove="Assets\CG\**" />
    <None Remove="Assets\SE\**" />
    <Page Remove="Assets\CG\**" />
    <Page Remove="Assets\SE\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Audio\BGM\school.mp3" />
    <None Remove="Assets\Audio\SE\click.wav" />
    <None Remove="Assets\Backgrounds\road.jpg" />
    <None Remove="Assets\Backgrounds\school.jpg" />
    <None Remove="Assets\Characters\misaki_happy.png" />
    <None Remove="Assets\Characters\misaki_sad.png" />
    <None Remove="Assets\Characters\misaki_serious.png" />
    <None Remove="Assets\Characters\rina_happy.png" />
    <None Remove="Data\story.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Audio\BGM\road.mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Audio\SE\click.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\story.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Characters\Misaki\" />
    <Folder Include="Assets\Characters\Rina\" />
    <Folder Include="ViewModels\" />
    <Folder Include="Resources\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Audio\BGM\school.mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\Backgrounds\road.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Backgrounds\school.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Characters\misaki_happy.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Characters\misaki_normal.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Characters\misaki_sad.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Characters\misaki_serious.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Characters\rina_happy.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Characters\rina_normal.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
