<Window x:Class="AkexiVN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkexiVN"
        mc:Ignorable="d"
        Title="AkexiVN"
        Width="1280"
        Height="720"
        MinWidth="1280"
        MinHeight="720"
        MaxWidth="1280"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <Grid>

        <MediaElement x:Name="BgmPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Volume="0.5"
                      Visibility="Collapsed"/>

        <MediaElement x:Name="SePlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Volume="0.8"
                      Visibility="Collapsed"/>

        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"/>

        <Canvas x:Name="CharacterLayer"
                Width="1280"
                Height="720"
                IsHitTestVisible="False"/>

        <StackPanel x:Name="ChoicePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="600"/>

        <Border x:Name="DialogueBox"
                Background="#DD101010"
                Height="180"
                VerticalAlignment="Bottom"
                Margin="30,0,30,20"
                CornerRadius="10">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="CharacterNameText"
                           Foreground="#FFD86B"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock x:Name="DialogueText"
                           Grid.Row="1"
                           Foreground="White"
                           FontSize="22"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           LineHeight="34"/>
            </Grid>
        </Border>

        <Button x:Name="NextButton"
                Content="▶"
                Width="50"
                Height="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,55,45"
                FontSize="20"
                Background="#AAFFFFFF"
                BorderThickness="0"
                Click="NextButton_Click"/>

        <Button x:Name="MenuButton"
                Content="菜单"
                Width="100"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Click="MenuButton_Click"/>

        <Grid x:Name="MenuOverlay"
              Visibility="Collapsed">
            <Border Background="#66000000"/>

            <Border x:Name="MenuPanel"
                    Background="#CC101010"
                    Width="360"
                    CornerRadius="12"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="游戏菜单"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <Button Content="保存"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="SaveMenuButton_Click"/>

                    <Button Content="读取"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="LoadMenuButton_Click"/>

                    <Button Content="设置"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="SettingsMenuButton_Click"/>

                    <Button Content="返回标题"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="ReturnTitleButton_Click"/>

                    <Button Content="关闭"
                            Height="44"
                            Click="CloseMenuButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="SaveLoadPanel"
                    Background="#CC101010"
                    Width="620"
                    CornerRadius="12"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="SaveLoadTitle"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="SaveLoadStatus"
                               Foreground="#D0D0D0"
                               FontSize="14"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <StackPanel x:Name="SaveSlotList"/>

                    <Button Content="返回菜单"
                            Height="40"
                            Width="140"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Click="BackToMenuButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

