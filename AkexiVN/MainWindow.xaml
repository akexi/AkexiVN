<Window x:Class="AkexiVN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkexiVN"
        mc:Ignorable="d"
        Title="AkexiVN"
        Width="1280"
        Height="720"
        MinWidth="1280"
        MinHeight="720"
        MaxWidth="1280"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <Grid>
        <!-- Audio Players -->
        <MediaElement x:Name="BgmPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Volume="0.5"
                      Visibility="Collapsed"/>

        <MediaElement x:Name="SePlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Volume="0.8"
                      Visibility="Collapsed"/>

        <!-- Main Menu Panel -->
        <Grid x:Name="MainMenuPanel" Visibility="Visible">
            <Border Background="#15151C"/>

            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Width="300">
                    <TextBlock Text="AkexiVN"
                               Foreground="White"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,40"/>

                    <Button x:Name="StartGameButton"
                            Content="开始游戏"
                            Height="48"
                            FontSize="18"
                            Margin="0,0,0,12"
                            Click="StartGameButton_Click"/>

                    <Button x:Name="ContinueGameButton"
                            Content="继续游戏"
                            Height="48"
                            FontSize="18"
                            Margin="0,0,0,12"
                            Click="ContinueGameButton_Click"/>

                    <Button x:Name="LoadGameMainMenuButton"
                            Content="读取存档"
                            Height="48"
                            FontSize="18"
                            Margin="0,0,0,12"
                            Click="LoadGameMainMenuButton_Click"/>

                    <Button x:Name="SettingsMainMenuButton"
                            Content="设置"
                            Height="48"
                            FontSize="18"
                            Margin="0,0,0,12"
                            Click="SettingsMainMenuButton_Click"/>

                    <Button x:Name="ExitGameButton"
                            Content="退出游戏"
                            Height="48"
                            FontSize="18"
                            Margin="0,0,0,12"
                            Click="ExitGameButton_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Version 0.1.0"
                       Foreground="#888888"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,24"/>
        </Grid>

        <!-- Game Panel -->
        <Grid x:Name="GamePanel" Visibility="Collapsed">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>

            <Canvas x:Name="CharacterLayer"
                    Width="1280"
                    Height="720"
                    IsHitTestVisible="False"/>

            <StackPanel x:Name="ChoicePanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="600"/>

            <Border x:Name="DialogueBox"
                    Background="#DD101010"
                    Height="180"
                    VerticalAlignment="Bottom"
                    Margin="30,0,30,20"
                    CornerRadius="10">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CharacterNameText"
                               Foreground="#FFD86B"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="DialogueText"
                               Grid.Row="1"
                               Foreground="White"
                               FontSize="22"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               LineHeight="34"/>
                </Grid>
            </Border>

            <Button x:Name="NextButton"
                    Content="▶"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,55,45"
                    FontSize="20"
                    Background="#AAFFFFFF"
                    BorderThickness="0"
                    Click="NextButton_Click"/>

            <Button x:Name="MenuButton"
                    Content="菜单"
                    Width="100"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20,20,0,0"
                    Click="MenuButton_Click"/>
        </Grid>

        <!-- Overlay Container (In-Game Menu, Save/Load Panel, Settings Panel) -->
        <Grid x:Name="OverlayContainer" Visibility="Collapsed">
            <Border Background="#AA000000"/>

            <!-- In-Game Pause Menu -->
            <Border x:Name="InGameMenuPanel"
                    Background="#CC101010"
                    Width="360"
                    CornerRadius="12"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="游戏菜单"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <Button Content="保存"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="InGameSaveButton_Click"/>

                    <Button Content="读取"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="InGameLoadButton_Click"/>

                    <Button Content="设置"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="InGameSettingsButton_Click"/>

                    <Button Content="返回标题"
                            Height="44"
                            Margin="0,0,0,12"
                            Click="ReturnTitleButton_Click"/>

                    <Button Content="关闭"
                            Height="44"
                            Click="CloseMenuButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Save / Load Panel -->
            <Border x:Name="SaveLoadPanel"
                    Background="#EE101010"
                    Width="800"
                    Height="560"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="SaveLoadTitle"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="SaveLoadStatus"
                                   Foreground="#D0D0D0"
                                   FontSize="14"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SaveSlotList"/>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="返回"
                            Height="40"
                            Width="140"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Click="BackFromSaveLoad_Click"/>
                </Grid>
            </Border>

            <!-- Settings Panel -->
            <Border x:Name="SettingsPanel"
                    Background="#EE101010"
                    Width="600"
                    Height="400"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="设置"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,0,20,0">
                        <!-- BGM Volume -->
                        <TextBlock Text="BGM 音量" Foreground="White" FontSize="18" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BgmVolumeSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    Value="0.5"
                                    VerticalAlignment="Center"
                                    ValueChanged="BgmVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="BgmVolumeText"
                                       Grid.Column="1"
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="50%"/>
                        </Grid>

                        <!-- SE Volume -->
                        <TextBlock Text="SE 音量" Foreground="White" FontSize="18" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SeVolumeSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    Value="0.8"
                                    VerticalAlignment="Center"
                                    ValueChanged="SeVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="SeVolumeText"
                                       Grid.Column="1"
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="80%"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="返回"
                            Height="40"
                            Width="140"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Click="BackFromSettings_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
